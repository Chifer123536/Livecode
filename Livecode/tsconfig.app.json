{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"allowJs": true,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"types": [
			"vitest/globals",
			"@testing-library/jest-dom/vitest",
			"node"
		]
	},
	"include": [
		"src"
	]
}
