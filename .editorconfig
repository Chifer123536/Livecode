# Базовые правила для любого редактора (VS Code, WebStorm, Vim).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 2
tab_width = 2
insert_final_newline = true
trim_trailing_whitespace = true

# В YAML табы запрещены спецификацией — только пробелы.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# В Markdown два пробела на конце строки — это перенос, срезать нельзя.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
