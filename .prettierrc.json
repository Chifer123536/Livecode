{
	"useTabs": true,
	"tabWidth": 2,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"printWidth": 100,
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"endOfLine": "lf",
	"overrides": [
		{
			"files": [
				"*.yml",
				"*.yaml",
				"*.md"
			],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
